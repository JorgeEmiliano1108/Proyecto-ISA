# --- Bases de Datos y Caché ---
# Nota: Si el servicio corre local (fuera de Docker), cambia "reports_db" y "reports_redis" por "localhost"
DATABASE_URL="postgresql://postgres:postgres_secure_password_2024@reports_db:5432/isa_db"
MS3_REDIS_URL="redis://reports_redis:6379/0"

# --- Almacenamiento en la Nube (S3 / MinIO) ---
MS3_S3_ENDPOINT="http://minio:9000"
MS3_S3_ACCESS_KEY="minioadmin"
MS3_S3_SECRET_KEY="minioadmin"
MS3_S3_BUCKET="reports"

# --- Inteligencia Artificial Local (Ollama + Qdrant) ---
OLLAMA_BASE_URL="http://ollama_reports:11434"
OLLAMA_LLM_MODEL="phi3"
OLLAMA_EMBED_MODEL="nomic-embed-text"

QDRANT_URL="http://reports_qdrant:6333"
QDRANT_COLLECTION="isa_reports_styles"

# report_service — Variables de Entorno
# Copia este archivo como .env y edita los valores reales

# API y Seguridad
MS3_HOST=0.0.0.0
MS3_PORT=8003
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Base de Datos Local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@reports_db:5432/isa_db

# Redis
MS3_REDIS_URL=redis://reports_redis:6379/0

# S3 / MinIO
MS3_S3_ENDPOINT=http://minio:9000
MS3_S3_PUBLIC_ENDPOINT=http://localhost:9003
MS3_S3_ACCESS_KEY=minioadmin
MS3_S3_SECRET_KEY=minioadmin
MS3_S3_BUCKET=reportes-isa

# Backend Django API (para fetch de evaluaciones)
BACKEND_API_URL=http://backend:8000
BACKEND_INTERNAL_TOKEN=

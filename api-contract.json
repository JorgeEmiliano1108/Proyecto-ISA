{
  "openapi": "3.0.3",
  "info": {
    "title": "ISA Corporativo — API REST",
    "version": "1.0.0",
    "description": "API del sistema de gestión empresarial ISA Corporativo. Frontend MPA con Vanilla JS + Bootstrap 5."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Servidor de desarrollo"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "admin" },
          "password": { "type": "string", "example": "admin" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "access": { "type": "string", "example": "<JWT>" },
          "refresh": { "type": "string", "example": "<JWT>" }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refresh"],
        "properties": {
          "refresh": { "type": "string", "example": "<refresh_token>" }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "properties": {
          "access": { "type": "string", "example": "<nuevo_JWT>" },
          "refresh": { "type": "string", "example": "<nuevo_refresh>" }
        }
      },
      "JwtPayload": {
        "type": "object",
        "properties": {
          "rol_nombre": { "type": "string", "example": "Administrador" },
          "nombre_completo": { "type": "string", "example": "Admin" },
          "username": { "type": "string", "example": "admin" },
          "puesto": { "type": "string", "example": "" },
          "user_id": { "type": "integer", "example": 1 },
          "departamento_id": { "type": "integer", "example": 1 },
          "exp": { "type": "integer", "example": 1700000000 }
        }
      },
      "DashboardResumen": {
        "type": "object",
        "properties": {
          "usuarios": { "type": "integer", "example": 150 },
          "evaluaciones": { "type": "integer", "example": 45 },
          "pendientes": { "type": "integer", "example": 12 },
          "bonos": { "type": "integer", "example": 8 }
        }
      },
      "ActividadItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "text": { "type": "string" },
          "time": { "type": "string" },
          "icon": { "type": "string" },
          "color": { "type": "string" }
        }
      },
      "TareaItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "date": { "type": "string" },
          "badge": { "type": "string" }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "nombre": { "type": "string", "example": "Sarah Jenkins" },
          "email": { "type": "string", "example": "sarah.j@empresa.com" },
          "rol": { "type": "string", "example": "Arquitecta Sr." },
          "dept": { "type": "string", "example": "Estrategia de Producto" },
          "estado": { "type": "string", "example": "Activo", "enum": ["Activo", "Inactivo"] },
          "ultimoLogin": { "type": "string", "example": "Hace 2 min" }
        }
      },
      "UsuariosResumen": {
        "type": "object",
        "properties": {
          "total": { "type": "integer", "example": 1284 },
          "activos": { "type": "integer", "example": 412 }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true }
        }
      },
      "Categoria": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "nombre": { "type": "string" },
          "icono": { "type": "string" },
          "activo": { "type": "boolean" }
        }
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "NAV_DASHBOARD_MAIN" },
          "titulo": { "type": "string", "example": "Dashboard" },
          "icono": { "type": "string", "example": "bi-speedometer2" },
          "estado": { "type": "string", "example": "VISIBLE", "enum": ["VISIBLE", "BLOQUEADO", "OCULTO"] },
          "badgeClass": { "type": "string" },
          "subitems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "titulo": { "type": "string" },
                "icono": { "type": "string" }
              }
            }
          }
        }
      },
      "ActividadCatalogo": {
        "type": "object",
        "properties": {
          "usuario": { "type": "string" },
          "accion": { "type": "string" },
          "detalle": { "type": "string" },
          "tiempo": { "type": "string" },
          "color": { "type": "string" }
        }
      },
      "CriterioEvaluacion": {
        "type": "object",
        "required": ["pregunta", "tipo"],
        "properties": {
          "pregunta": { "type": "string" },
          "tipo": { "type": "string", "enum": ["OPCIÓN MÚLTIPLE", "ESCALA LINEAL", "TEXTO LARGO"] },
          "opciones": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "EvaluacionDefinition": {
        "type": "object",
        "required": ["title", "criteria"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "audience": { "type": "string" },
          "criteria": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CriterioEvaluacion" }
          }
        }
      },
      "FilaSupervision": {
        "type": "array",
        "description": "Array de 12 elementos: [#, Usuario, Estado, Liderazgo, Comunicación, Proactividad, Colaboración, Adaptabilidad, Orient. Resultados, Promedio, Eval. Global, Última Modificación]",
        "example": [1, "Juan Pérez", "En Proceso", 4, 5, 3, 4, 5, 4, 4.17, 3.34, "2025-01-15 10:30"],
        "items": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string" },
            { "type": "number" }
          ]
        }
      },
      "Solicitud": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "tipo": { "type": "string", "enum": ["EVALUACIÓN", "BONO", "ACTUALIZACIÓN"] },
          "titulo": { "type": "string" },
          "solicitante": { "type": "string" },
          "puesto": { "type": "string" },
          "fecha": { "type": "string" },
          "resumen": { "type": "string" },
          "monto": { "type": "string" },
          "icono": { "type": "string" },
          "colorIcono": { "type": "string" },
          "bgIcono": { "type": "string" },
          "badgeColor": { "type": "string" }
        }
      },
      "HistorialSolicitud": {
        "type": "object",
        "properties": {
          "entidad": { "type": "string" },
          "tipo": { "type": "string" },
          "accion": { "type": "string" },
          "fecha": { "type": "string" },
          "resultado": { "type": "string", "enum": ["APROBADO", "RECHAZADO"] },
          "aprobador": { "type": "string" }
        }
      },
      "ReportesResponse": {
        "type": "object",
        "properties": {
          "kpis": {
            "type": "object",
            "properties": {
              "total": { "type": "integer" },
              "promedio": { "type": "number" },
              "tasa": { "type": "string" },
              "registros": { "type": "integer" },
              "comp": { "type": "string" }
            }
          },
          "tendencias": {
            "type": "object",
            "properties": {
              "labels": { "type": "array", "items": { "type": "string" } },
              "data": { "type": "array", "items": { "type": "number" } },
              "titulo": { "type": "string" }
            }
          },
          "departamentos": {
            "type": "object",
            "properties": {
              "labels": { "type": "array", "items": { "type": "string" } },
              "data": { "type": "array", "items": { "type": "number" } }
            }
          },
          "tabla": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "nombre": { "type": "string" },
                "dept": { "type": "string" },
                "fecha": { "type": "string" },
                "score": { "type": "number" },
                "status": { "type": "string" },
                "colorStatus": { "type": "string" }
              }
            }
          }
        }
      },
      "ProgramasBonos": {
        "type": "object",
        "properties": {
          "programa1": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "participantes": { "type": "integer" },
              "presupuesto": { "type": "string" },
              "desc": { "type": "string" }
            }
          },
          "programa2": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "lanzamiento": { "type": "string" },
              "responsabilidad": { "type": "string" },
              "desc": { "type": "string" }
            }
          },
          "flujo": {
            "type": "object",
            "properties": {
              "total": { "type": "string" },
              "preparacion": { "type": "integer" },
              "totalEmpleados": { "type": "integer" }
            }
          }
        }
      },
      "AsignacionEmpleado": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "nombre": { "type": "string" },
          "puesto": { "type": "string" },
          "programa": { "type": "string" },
          "metodo": { "type": "string" },
          "estado": { "type": "string" },
          "progreso": { "type": "integer" },
          "claseProgreso": { "type": "string" },
          "pago": { "type": "string" }
        }
      },
      "Consulta": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1700000000000 },
          "usuario": { "type": "string" },
          "fecha": { "type": "string", "format": "date" },
          "pregunta": { "type": "string" },
          "estado": { "type": "string", "enum": ["pendiente", "respondido"] },
          "respuesta": { "type": "string", "nullable": true },
          "fechaRespuesta": { "type": "string", "format": "date", "nullable": true }
        }
      },
      "ResponderConsultaRequest": {
        "type": "object",
        "required": ["respuesta"],
        "properties": {
          "respuesta": { "type": "string" }
        }
      },
      "Notificacion": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1700000000000 },
          "titulo": { "type": "string" },
          "mensaje": { "type": "string" },
          "tipo": { "type": "string", "enum": ["tarea", "comunicado", "mensaje"] },
          "fecha": { "type": "string", "format": "date" },
          "fechaLimite": { "type": "string", "format": "date", "nullable": true },
          "para": { "type": "string", "enum": ["todos", "usuario"] },
          "leido": { "type": "boolean", "default": false }
        }
      },
      "NotificacionRequest": {
        "type": "object",
        "required": ["titulo", "mensaje", "tipo"],
        "properties": {
          "titulo": { "type": "string" },
          "mensaje": { "type": "string" },
          "tipo": { "type": "string", "enum": ["tarea", "comunicado"] },
          "fechaLimite": { "type": "string", "format": "date" },
          "para": { "type": "string", "enum": ["todos", "usuario"] }
        }
      },
      "ThemeColor": {
        "type": "object",
        "properties": {
          "color": { "type": "string", "example": "#2563eb" }
        }
      },
      "Perfil": {
        "type": "object",
        "properties": {
          "nombre": { "type": "string" },
          "email": { "type": "string" },
          "telefono": { "type": "string" },
          "departamento": { "type": "string" },
          "puesto": { "type": "string" }
        }
      },
      "UsuarioDashboard": {
        "type": "object",
        "properties": {
          "nombre": { "type": "string", "example": "Sarah Jenkins" },
          "promedio": { "type": "number", "example": 4.92 },
          "pendientes": { "type": "integer", "example": 2 },
          "vencimiento": { "type": "string", "example": "20 de Octubre" },
          "bono": { "type": "string", "example": "$2,450.00" }
        }
      },
      "EvaluacionPendiente": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 201 },
          "titulo": { "type": "string" },
          "limite": { "type": "string" },
          "categoria": { "type": "string" }
        }
      },
      "EvaluacionHistorial": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "titulo": { "type": "string" },
          "fecha": { "type": "string" },
          "evaluador": { "type": "string" },
          "score": { "type": "number" }
        }
      },
      "GrillaISA": {
        "type": "object",
        "properties": {
          "colaborador": { "type": "string" },
          "puesto_colaborador": { "type": "string" },
          "evaluador": { "type": "string" },
          "puesto_evaluador": { "type": "string" },
          "jefe_inmediato": { "type": "string" },
          "puesto_jefe": { "type": "string" },
          "fecha_ingreso": { "type": "string", "format": "date" },
          "fecha_evaluacion": { "type": "string", "format": "date" },
          "fecha_revision": { "type": "string", "format": "date" },
          "periodo": { "type": "string" },
          "resultados_2025": { "type": "string" },
          "compromisos_2026": { "type": "string" },
          "competencias": {
            "type": "object",
            "properties": {
              "1": { "type": "integer", "minimum": 0, "maximum": 5, "description": "Orientación al cliente" },
              "2": { "type": "integer", "minimum": 0, "maximum": 5, "description": "Enfoque a resultados" },
              "3": { "type": "integer", "minimum": 0, "maximum": 5, "description": "Confiabilidad" },
              "4": { "type": "integer", "minimum": 0, "maximum": 5, "description": "Trabajo en equipo" },
              "5": { "type": "integer", "minimum": 0, "maximum": 5, "description": "Innovación y desarrollo" },
              "6": { "type": "integer", "minimum": 0, "maximum": 5, "description": "Liderazgo" }
            }
          },
          "evaluacion_global": { "type": "string" },
          "comentarios_evaluador": { "type": "string" },
          "comentarios_colaborador": { "type": "string" },
          "firma_colaborador": { "type": "string" },
          "fecha_entrega": { "type": "string", "format": "date" },
          "firma_evaluador": { "type": "string" },
          "firma_jefe": { "type": "string" }
        }
      },
      "BonoActual": {
        "type": "object",
        "properties": {
          "nombre": { "type": "string" },
          "descripcion": { "type": "string" },
          "progreso": { "type": "integer", "minimum": 0, "maximum": 100 },
          "montoProyectado": { "type": "string" },
          "fechaInicio": { "type": "string" },
          "fechaCierre": { "type": "string" },
          "estado": { "type": "string" }
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "titulo": { "type": "string" },
          "meta": { "type": "string" },
          "actual": { "type": "string" },
          "icono": { "type": "string" }
        }
      },
      "Pago": {
        "type": "object",
        "properties": {
          "fecha": { "type": "string" },
          "concepto": { "type": "string" },
          "monto": { "type": "string" },
          "estado": { "type": "string" }
        }
      },
      "MetricasHistoricas": {
        "type": "object",
        "properties": {
          "etiquetas": { "type": "array", "items": { "type": "string" } },
          "valores": { "type": "array", "items": { "type": "number" } }
        }
      },
      "CompetenciasData": {
        "type": "object",
        "properties": {
          "categorias": { "type": "array", "items": { "type": "string" } },
          "valores": { "type": "array", "items": { "type": "number" } }
        }
      },
      "ReporteDocumento": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "periodo": { "type": "string" },
          "tipo": { "type": "string" },
          "score": { "type": "number" },
          "fecha": { "type": "string" }
        }
      },
      "CrearConsultaRequest": {
        "type": "object",
        "required": ["pregunta"],
        "properties": {
          "pregunta": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/auth/login/": {
      "post": {
        "tags": ["Auth"],
        "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/auth/refresh/": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refrescar token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token refrescado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RefreshResponse" }
              }
            }
          },
          "401": {
            "description": "Refresh token inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/admin/dashboard/resumen": {
      "get": {
        "tags": ["Admin — Dashboard"],
        "summary": "KPIs del dashboard",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Indicadores clave",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardResumen" }
              }
            }
          }
        }
      }
    },
    "/admin/dashboard/actividad": {
      "get": {
        "tags": ["Admin — Dashboard"],
        "summary": "Actividad reciente",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de actividad reciente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ActividadItem" }
                }
              }
            }
          }
        }
      }
    },
    "/admin/dashboard/tareas": {
      "get": {
        "tags": ["Admin — Dashboard"],
        "summary": "Próximas tareas",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de próximas tareas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TareaItem" }
                }
              }
            }
          }
        }
      }
    },
    "/admin/usuarios": {
      "get": {
        "tags": ["Admin — Usuarios"],
        "summary": "Listar usuarios",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filtro por nombre o email"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de usuarios",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Usuario" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Admin — Usuarios"],
        "summary": "Crear usuario",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Usuario" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
              }
            }
          }
        }
      }
    },
    "/admin/usuarios/resumen": {
      "get": {
        "tags": ["Admin — Usuarios"],
        "summary": "KPIs de usuarios",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Resumen de usuarios",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsuariosResumen" }
              }
            }
          }
        }
      }
    },
    "/admin/usuarios/{id}": {
      "put": {
        "tags": ["Admin — Usuarios"],
        "summary": "Actualizar usuario",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Usuario" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario actualizado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Admin — Usuarios"],
        "summary": "Eliminar usuario",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario eliminado",

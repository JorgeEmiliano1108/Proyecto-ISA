# bonus_service — Variables de Entorno
# Copia este archivo como .env y edita los valores reales

# Base de Datos (escritura)
DB_USER=postgres
DB_NAME=postgres
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=reemplazar

# Base de Datos (lectura de evaluaciones)
EVAL_DB_USER=postgres
EVAL_DB_NAME=postgres
EVAL_DB_HOST=localhost
EVAL_DB_PORT=5432
EVAL_DB_PASSWORD=reemplazar

DB_MODE=development
DEBUG_MODE=True

# Redis / Celery
REDIS_URL=redis://bonus_redis:6379/0
CELERY_BROKER_URL=redis://bonus_redis:6379/0
CELERY_RESULT_BACKEND=redis://bonus_redis:6379/1

# Seguridad
SECRET_KEY=reemplazar-en-produccion
ENCRYPTION_KEY=reemplazar-con-llave-fernet-32-bytes
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# =====================================================================
# BACKEND DJANGO — Variables de Entorno (ISA Corporativo)
# Copia este archivo como .env y edita los valores reales
# =====================================================================

# ── Django ──────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-reemplazar-en-produccion
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,backend-django,backend

# ── Supabase (PostgreSQL Cloud) ─────────────────────────────────────
SUPABASE_URL=postgresql+asyncpg://usuario:password@host:5432/nombre_bd

# ── API Externa ISA (SSO/AD/SIARE) ─────────────────────────────────
ISA_API_URL=*
ISA_CLIENT_ID=solicitar-al-equipo-isa
ISA_CLIENT_SECRET=solicitar-al-equipo-isa

# ── JWT RS256 ───────────────────────────────────────────────────────
# Generar con: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
# exportar single-line con: Get-Content private.pem -Raw | ForEach-Object { $_ -replace "`n", "\n" }
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Backend Internal Token (para microservicios) ────────────────────
# JWT que los microservicios (report_service) usan para autenticarse contra el backend
# Generar con: python manage.py drf_create_token admin
# O usar un JWT firmado con la PRIVATE_KEY
BACKEND_INTERNAL_TOKEN=

# ── Redis (para eventos Pub/Sub) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
